modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["unzip"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5904
externalPort = 3001

[[ports]]
localPort = 23636
externalPort = 3000

[[ports]]
localPort = 23637
externalPort = 3002

[[ports]]
localPort = 23638
externalPort = 4200

[[ports]]
localPort = 23639
externalPort = 3003

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "dist/index.cjs"]
build = ["npm", "run", "build"]
publicDir = "dist/public"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[agent]
integrations = ["resend:1.0.0"]

[userenv]

[userenv.development]
APP_URL = "https://62492d7b-747b-431b-b4ea-119a665943ae-00-1gvabqqkfi1x3.spock.replit.dev"

[userenv.shared]
ADMIN_EMAIL = "admin@example.com"
RESEND_FROM_EMAIL = "Lumen Fidei <noreply@lumenfi.app>"
RESEND_REPLY_TO_EMAIL = "benjamin.c.ludolph@gmail.com"
